{
  "name": "rootcap",
  "version": "1.1.0",
  "type": "module",
  "description": "A privacy-first, self-hosted captcha alternative powered by proof-of-work.",
  "license": "MIT",
  "homepage": "https://rootcap.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirasync2748/rootcap.git"
  },
  "bugs": "https://github.com/kirasync2748/rootcap/issues",
  "keywords": [
    "captcha",
    "proof-of-work",
    "privacy",
    "self-hosted",
    "widget",
    "human-verification",
    "web-worker",
    "zero-dependency",
    "stateless",
    "no-tracking"
  ],
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./widget": {
      "types": "./dist/widget/widget.d.ts",
      "import": "./dist/widget/widget.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:types": "tsc -p tsconfig.lib.json",
    "start": "node server.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run build:lib && npm run build:types",
    "prepack": "npm run build:lib && npm run build:types"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
